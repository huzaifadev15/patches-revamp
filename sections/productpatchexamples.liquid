<section class="product-patch-examples section-{{ section.id }}">
  {% if section.settings.heading != blank %}
    <h2 class="product-patch-examples__heading">{{ section.settings.heading | escape }}</h2>
  {% endif %}

  {% capture example_cards %}
    {% if section.blocks.size > 0 %}
      {% for block in section.blocks %}
        <div class="product-patch-examples__card" {{ block.shopify_attributes }}>
          <div class="product-patch-examples__media">
            {% if block.settings.image != blank %}
              {{
                block.settings.image
                | image_url: width: 600
                | image_tag:
                  loading: 'lazy',
                  class: 'product-patch-examples__img',
                  widths: '200, 360, 600',
                  sizes: '(min-width: 990px) 22vw, 70vw',
                  alt: block.settings.caption | default: block.settings.image.alt
              }}
            {% else %}
              <div class="product-patch-examples__ph" aria-hidden="true"></div>
            {% endif %}
          </div>
          {% if block.settings.caption != blank %}
            <p class="product-patch-examples__caption">{{ block.settings.caption | escape }}</p>
          {% endif %}
        </div>
      {% endfor %}
    {% else %}
      <div class="product-patch-examples__card">
        <div class="product-patch-examples__media">
          <div class="product-patch-examples__ph" aria-hidden="true"></div>
        </div>
        <p class="product-patch-examples__caption">Vibrant Colors &amp; Detail</p>
      </div>
      <div class="product-patch-examples__card">
        <div class="product-patch-examples__media">
          <div class="product-patch-examples__ph" aria-hidden="true"></div>
        </div>
        <p class="product-patch-examples__caption">Custom Shapes &amp; Clean Edges</p>
      </div>
      <div class="product-patch-examples__card">
        <div class="product-patch-examples__media">
          <div class="product-patch-examples__ph" aria-hidden="true"></div>
        </div>
        <p class="product-patch-examples__caption">Any Design Possible</p>
      </div>
    {% endif %}
  {% endcapture %}

  <div class="product-patch-examples__scroller">
    <div class="product-patch-examples__track">
      <div class="product-patch-examples__row">
        {{ example_cards }}
      </div>
      <div class="product-patch-examples__row" aria-hidden="true">
        {{ example_cards }}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Patch examples",
  "tag": "section",
  "class": "section-product-patch-examples",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Embroidered Patch Examples"
    }
  ],
  "blocks": [
    {
      "type": "example",
      "name": "Example",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption",
          "default": "Vibrant Colors & Detail"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Patch examples",
      "blocks": [
        {
          "type": "example",
          "settings": {
            "caption": "Vibrant Colors & Detail"
          }
        },
        {
          "type": "example",
          "settings": {
            "caption": "Custom Shapes & Clean Edges"
          }
        },
        {
          "type": "example",
          "settings": {
            "caption": "Any Design Possible"
          }
        }
      ]
    }
  ]
}
{% endschema %}
