      "id": "subheading",
      "label": "Subheading",
      "default": "Verified Feedback from Authentic Customers"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review card",
      "settings": [
        {
          "type": "text",
          "id": "name",
